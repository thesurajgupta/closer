# ---------------------------------------------------------------------------
# CLOSER — configuration
# Copy to .env and adjust. The demo runs with none of these set.
# ---------------------------------------------------------------------------

# demo | live   ("live" requires real connector implementations, see README)
CLOSER_MODE=demo

# Fixed wall clock so the demo is reproducible on any date.
CLOSER_DEMO_NOW=2026-09-10T09:00:00

# Where the local structured store lives.
CLOSER_DB=./closer.db

# auto | deterministic | bedrock | anthropic
#   auto          picks bedrock/anthropic when credentials exist, else deterministic
#   deterministic local Strands model provider — no credentials, fully reproducible
CLOSER_MODEL_PROVIDER=auto
CLOSER_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
CLOSER_ANTHROPIC_MODEL_ID=claude-sonnet-4-5-20250929
AWS_REGION=us-west-2

# Hard safety rails. Lowering these tightens CLOSER; nothing can raise them at runtime.
CLOSER_MAX_ITERATIONS=14
CLOSER_MAX_ACTION_AMOUNT=25000
CLOSER_MAX_RETRIES=3
CLOSER_TOOL_TIMEOUT=20

# Background execution (EventBridge/SQS equivalents when deployed to AWS)
CLOSER_SCHEDULER=false
CLOSER_DISCOVERY_MINUTES=1440
CLOSER_FOLLOW_UP_MINUTES=360

# Demo only: make named connector operations fail on their first attempt, so the
# retry/backoff path is visible. Comma separated.
#   email.send, calendar.reschedule, billing.dispute, warranty.submit_claim,
#   documents.upload, delivery.book_redelivery
# CLOSER_DEMO_FAIL_ONCE=warranty.submit_claim

# Credentials are read from the environment or AWS Secrets Manager. Never commit them.
# ANTHROPIC_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
